---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Credentials from '../components/sections/Credentials.astro';
import About from '../components/sections/About.astro';
import Services from '../components/sections/Services.astro';
import FirstVisit from '../components/sections/FirstVisit.astro';
import Insurances from '../components/sections/Insurances.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Office from '../components/sections/Office.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Footer from '../components/sections/Footer.astro';
import StickyBookingBar from '../components/sections/StickyBookingBar.astro';
---

<BaseLayout>
  <Navbar />
  <main id="contenido">
    <Hero />
    <Credentials />
    <About />
    <Services />
    <FirstVisit />
    <Insurances />
    <Testimonials />
    <Office />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <StickyBookingBar />
</BaseLayout>
