---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { site, links } from '../../content/site';

const { cta } = site;
---

<section aria-labelledby="final-cta-title" class="py-20 md:py-28">
  <Container>
    <div class="reveal grid items-center gap-10 rounded-photo bg-tint-sage px-7 py-14 md:px-14 md:py-20 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h2 id="final-cta-title" class="text-display-lg text-accent">
          {cta.finalTitle}
          <span class="block text-brand">{cta.finalTitleMuted}</span>
        </h2>
        <p class="mt-5 max-w-[32rem] text-lg text-brand">{cta.finalText}</p>
      </div>
      <div class="flex flex-col gap-3 lg:col-span-4 lg:items-stretch">
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <Button href={links.booking} external arrow size="lg">{cta.primaryLabel}</Button>
          <Button href={links.whatsapp} external variant="secondary" icon="message-circle" size="lg">
            {cta.whatsappLabel}
          </Button>
        </div>
        <p class="text-[0.9375rem] text-brand">{cta.finalNote}</p>
      </div>
    </div>
  </Container>
</section>
