---
import { Icon } from 'astro-icon/components';
import Container from '../ui/Container.astro';
import { site, licenseLabel } from '../../content/site';

const { professional, insurances, ui, sections } = site;
const c = ui.credentials;
const insuranceCount = insurances.list.length;
---

<section aria-labelledby="credentials-title" class="pb-16 pt-6 md:pb-20 md:pt-4">
  <h2 id="credentials-title" class="sr-only">{sections.credentials.title}</h2>
  <Container>
    <dl class="grid border-y border-border sm:grid-cols-2 lg:grid-cols-4">
      <div class="reveal flex items-baseline gap-4 border-b border-border py-7 sm:border-r sm:pr-6 lg:border-b-0">
        <dt class="sr-only">{c.yearsLabel}</dt>
        <dd class="contents">
          <span class="tabular font-serif text-display-md leading-none text-ink">
            <span data-count-to={professional.yearsOfPractice}>{professional.yearsOfPractice}</span>{c.yearsSuffix}
          </span>
          <span class="max-w-[9rem] text-[0.9375rem] leading-snug text-ink-muted" aria-hidden="true">{c.yearsLabel}</span>
        </dd>
      </div>

      <div class="reveal flex items-baseline gap-4 border-b border-border py-7 sm:pl-6 lg:border-b-0 lg:border-r lg:pr-6" style="--delay: 80ms">
        <dt class="sr-only">{c.licenseLabel}</dt>
        <dd class="contents">
          <span class="tabular whitespace-nowrap font-serif text-display-sm leading-none text-ink">{licenseLabel}</span>
          <span class="max-w-[9rem] text-[0.9375rem] leading-snug text-ink-muted" aria-hidden="true">{c.licenseLabel}</span>
        </dd>
      </div>

      <div class="reveal flex items-center gap-4 border-b border-border py-7 sm:border-b-0 sm:border-r sm:pr-6 lg:pl-6" style="--delay: 160ms">
        <dt class="sr-only">{professional.education[0]}</dt>
        <dd class="flex items-center gap-4">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-brand-soft/50 text-brand" aria-hidden="true">
            <Icon name="lucide:graduation-cap" class="size-5" stroke-width="1.5" />
          </span>
          <span class="text-[0.9375rem] leading-snug text-ink-muted">{c.educationLabel}</span>
        </dd>
      </div>

      <div class="reveal py-5 sm:pl-6" style="--delay: 240ms">
        <dt class="sr-only">{c.insurancesLabel}</dt>
        <dd>
          <a
            href={`#${sections.insurances.anchor}`}
            class="group flex min-h-16 items-center justify-between gap-4 rounded-card bg-tint-sage px-5 py-3 text-accent transition-colors duration-300 hover:bg-surface-alt"
          >
            <span class="flex items-baseline gap-3">
              <span class="tabular font-serif text-display-sm leading-none">{insuranceCount}</span>
              <span class="text-[0.9375rem] leading-snug">{c.insurancesLabel}</span>
            </span>
            <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-surface-raised" aria-hidden="true">
              <Icon name="lucide:arrow-right" class="size-4.5 transition-transform duration-300 ease-out-soft group-hover:translate-x-0.5" stroke-width="1.75" />
            </span>
            <span class="sr-only">{c.insurancesMore}</span>
          </a>
        </dd>
      </div>
    </dl>
  </Container>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('[data-count-to]');

  if (!reduce && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const end = Number(el.dataset.countTo);
      const duration = 1200;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 4);
        el.textContent = String(Math.round(end * eased));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          run(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
