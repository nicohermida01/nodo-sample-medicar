---
import { Icon } from 'astro-icon/components';
import { site, links } from '../../content/site';

const { ui } = site;
---

<div
  id="sticky-booking"
  class="fixed inset-x-0 bottom-0 z-30 transition-transform duration-500 ease-out-soft data-[hidden=true]:translate-y-full motion-reduce:transition-none border-t border-border bg-surface/95 px-4 pt-3 backdrop-blur-sm lg:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
>
  <div class="mx-auto flex max-w-page gap-3">
    <a
      href={links.booking}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full bg-accent px-5 font-semibold text-on-accent transition-colors hover:bg-accent-hover"
    >
      <Icon name="lucide:calendar-check" class="size-5" aria-hidden="true" stroke-width="1.5" />
      {ui.stickyBar.booking}
    </a>
    <a
      href={links.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full border border-border-strong bg-surface-raised px-5 font-semibold text-ink transition-colors hover:bg-tint-sage"
    >
      <Icon name="lucide:message-circle" class="size-5" aria-hidden="true" stroke-width="1.5" />
      {ui.stickyBar.whatsapp}
    </a>
  </div>
</div>

<script>
  // Visible by default; only hides while the hero's own CTAs are on screen.
  const bar = document.getElementById('sticky-booking');
  const hero = document.getElementById('top');
  if (bar && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
      const entry = entries[entries.length - 1];
      bar.setAttribute('data-hidden', String(entry?.isIntersecting ?? false));
    }, {
      rootMargin: '0px 0px -55% 0px',
    }).observe(hero);
  }
</script>
