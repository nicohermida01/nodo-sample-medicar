---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { site, links } from '../../content/site';
import salaEspera from '../../assets/consultorio/sala-espera.jpg';
import consultorio from '../../assets/consultorio/consultorio.jpg';
import fachada from '../../assets/consultorio/fachada.jpg';

const { office, contact, sections, ui } = site;
const s = sections.office;
const photoSources = { 'sala-espera': salaEspera, consultorio, fachada } as const;
const photos = ui.office.photos.map((p) => ({ ...p, src: photoSources[p.key] }));
const [mainPhoto, ...sidePhotos] = photos;
const { address } = office;
---

<Section id={s.anchor} labelledby="office-title">
  <SectionHeading id="office-title" title={s.title} titleMuted={s.titleMuted} />

  <div class="grid gap-5 lg:grid-cols-12">
    {
      mainPhoto && (
        <div class="reveal overflow-hidden rounded-photo bg-tint-sand lg:col-span-8">
          <Picture
            formats={["avif", "webp"]}
            src={mainPhoto.src}
            alt={mainPhoto.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 760px, 92vw"
            class="aspect-[4/3] h-full w-full object-cover"
          />
        </div>
      )
    }
    <div class="grid grid-cols-2 gap-5 lg:col-span-4 lg:grid-cols-1">
      {
        sidePhotos.map((p, i) => (
          <div class="reveal overflow-hidden rounded-photo bg-tint-sand" style={`--delay: ${(i + 1) * 80}ms`}>
            <Picture
              formats={["avif", "webp"]}
              src={p.src}
              alt={p.alt}
              widths={[360, 560, 720]}
              sizes="(min-width: 1024px) 370px, 46vw"
              class="aspect-[4/3] h-full w-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-16">
    <dl class="reveal grid content-start gap-8 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
      <div class="flex gap-4">
        <Icon name="lucide:map-pin" class="mt-1 size-5 shrink-0 text-brand" aria-hidden="true" stroke-width="1.5" />
        <div>
          <dt class="text-[0.9375rem] font-semibold text-ink">{ui.office.addressLabel}</dt>
          <dd class="mt-1 text-ink-muted">
            {address.street}{address.detail && `, ${address.detail}`}<br />
            {address.city}, {address.region}
          </dd>
        </div>
      </div>
      <div class="flex gap-4">
        <Icon name="lucide:clock" class="mt-1 size-5 shrink-0 text-brand" aria-hidden="true" stroke-width="1.5" />
        <div>
          <dt class="text-[0.9375rem] font-semibold text-ink">{ui.office.hoursLabel}</dt>
          {office.hours.map((h) => <dd class="mt-1 text-ink-muted">{h.label}</dd>)}
          {office.notes.map((n) => <dd class="mt-1 text-[0.9375rem] text-ink-muted">{n}</dd>)}
        </div>
      </div>
      <div class="flex gap-4">
        <Icon name="lucide:phone" class="mt-1 size-5 shrink-0 text-brand" aria-hidden="true" stroke-width="1.5" />
        <div>
          <dt class="text-[0.9375rem] font-semibold text-ink">{ui.office.contactLabel}</dt>
          <dd class="mt-1">
            <a href={links.phone} class="link-underline inline-flex min-h-11 items-center text-ink-muted hover:text-ink">
              {contact.phoneDisplay}
            </a>
          </dd>
          <dd>
            <a href={links.email} class="link-underline inline-flex min-h-11 items-center text-ink-muted hover:text-ink">
              {contact.email}
            </a>
          </dd>
        </div>
      </div>
    </dl>

    <div class="reveal lg:col-span-7" data-map-facade data-map-src={address.mapEmbedUrl} data-map-title={ui.office.mapTitle}>
      <div class="relative flex aspect-[16/10] w-full flex-col items-center justify-center gap-4 overflow-hidden rounded-card border border-border bg-tint-sage p-6 text-center" data-map-slot>
        <span class="inline-flex size-14 items-center justify-center rounded-full bg-surface-raised text-brand" aria-hidden="true">
          <Icon name="lucide:map" class="size-6" stroke-width="1.5" />
        </span>
        <p class="font-serif text-display-sm text-accent">{address.street}, {address.city}</p>
        <div class="flex flex-wrap justify-center gap-3">
          <button
            type="button"
            class="inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-5 text-[0.9375rem] font-semibold text-on-accent transition-colors duration-300 hover:bg-accent-hover"
            data-map-load
          >
            <Icon name="lucide:map-pin" class="size-4.5" aria-hidden="true" stroke-width="1.5" />
            {ui.office.mapButton}
          </button>
          <a
            href={address.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border-strong bg-surface-raised px-5 text-[0.9375rem] font-semibold text-ink transition-colors duration-300 hover:border-brand-soft"
          >
            {ui.office.mapOpenExternal}
            <Icon name="lucide:arrow-up-right" class="size-4.5" aria-hidden="true" stroke-width="1.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-map-facade]').forEach((facade) => {
    const button = facade.querySelector<HTMLButtonElement>('[data-map-load]');
    const slot = facade.querySelector<HTMLElement>('[data-map-slot]');
    button?.addEventListener('click', () => {
      if (!slot || !facade.dataset.mapSrc) return;
      const iframe = document.createElement('iframe');
      iframe.src = facade.dataset.mapSrc;
      iframe.title = facade.dataset.mapTitle ?? '';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'aspect-[16/10] w-full rounded-card border border-border';
      slot.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
