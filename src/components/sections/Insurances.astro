---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { site } from '../../content/site';

const { insurances, sections, ui } = site;
const s = sections.insurances;
const items = [...insurances.list, ui.insurances.particularLabel];
---

<Section id={s.anchor} labelledby="insurances-title">
  <div class="grid items-end gap-10 lg:grid-cols-12">
    <SectionHeading id="insurances-title" title={s.title} intro={insurances.note} class="!mb-0 lg:col-span-5" />
    <ul class="reveal flex flex-wrap gap-3 lg:col-span-7 lg:justify-end">
      {
        items.map((name) => (
          <li class="inline-flex min-h-14 items-center rounded-full border border-border-strong bg-surface-raised px-6 font-serif text-[1.3125rem] text-ink">
            {name}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
