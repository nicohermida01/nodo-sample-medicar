---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { site } from '../../content/site';

const { firstVisit, sections } = site;
const s = sections.firstVisit;
---

<Section id={s.anchor} tone="alt" labelledby="first-visit-title">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <SectionHeading id="first-visit-title" title={s.title} intro={s.intro} class="lg:sticky lg:top-32" />
    </div>

    <ol class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
      {
        firstVisit.map((step, i) => (
          <li class="reveal border-t border-border-strong py-8" style={`--delay: ${(i % 2) * 80}ms`}>
            <span class="tabular font-serif text-display-sm text-brand-soft" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-display-sm text-ink">{step.title}</h3>
            <p class="mt-3 text-ink-muted">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
