---
import IconBadge from '../ui/IconBadge.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { site } from '../../content/site';

const { services, sections } = site;
const s = sections.services;

// Very soft tints rotate across the grid, as in the references; most cards stay raised white.
const tints = ['bg-tint-sage', 'bg-surface-raised', 'bg-surface-raised', 'bg-tint-sand', 'bg-surface-raised', 'bg-surface-raised'];
---

<Section id={s.anchor} labelledby="services-title">
  <SectionHeading id="services-title" title={s.title} titleMuted={s.titleMuted} intro={s.intro} />

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
    {
      services.map((service, i) => (
        <li
          class:list={[
            'reveal flex flex-col rounded-card border border-border p-7 transition-[border-color,background-color] duration-300 hover:border-brand-soft/60 md:p-8',
            tints[i % tints.length],
          ]}
          style={`--delay: ${(i % 3) * 70}ms`}
        >
          <IconBadge name={service.icon} />
          <h3 class="mt-8 text-display-sm text-ink">{service.title}</h3>
          <p class="mt-3 text-[1.0625rem] text-ink-muted">{service.description}</p>
        </li>
      ))
    }
  </ul>
</Section>
